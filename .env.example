# PAPER account settings
PAPER_INITIAL_CASH=1000000
PAPER_FEE_RATE=0.00015
PAPER_SLIPPAGE_RATE=0
PAPER_STATE_PATH=data/paper_state.sqlite3

# Toss Securities Open API
# Keep the real values in .env. .env is ignored by git.
TOSS_CLIENT_ID=your_toss_client_id
TOSS_CLIENT_SECRET=your_toss_client_secret
TOSS_ACCOUNT_SEQ=your_account_seq
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_WS_URL=wss://openapi-ws.tossinvest.com/ws/v1

# Phase 2 reads current prices only and feeds PAPER.
TOSS_MARKET_DATA_ENABLED=false
TOSS_API_TIMEOUT_SECONDS=10

# OpenAI-powered read-only dashboard assistant
# Keep the real API key only in .env. It is never sent to the browser.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-6-astra
